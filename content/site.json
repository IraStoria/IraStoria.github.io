  "about_body": {
    "zh": [
      "IraStoria，作曲與遊戲音訊設計者。長期關注「音樂如何回應互動」：不是把音樂貼在畫面上，而是讓音樂本身有結構地跟著玩家的節奏走。",
      "目前同時在做一款節奏遊戲與自製的 DAW／製譜工具。這個網站收錄作品、可操作的概念展示，以及零散的筆記。"
    ],
    "en": [
      "IraStoria — composer and game audio designer. My long-running interest is how music responds to interaction: not pasting music onto a screen, but letting the music itself follow the player's rhythm in a structured way.",
      "I am currently working on a rhythm game and a home-grown DAW / notation tool. This site collects works, hands-on concept demos, and scattered notes."
    ]
  },
  "fx": {
    "click": {
      "video": "assets/fx/click.mp4",
      "sound": "assets/fx/click.ogg",
      "sound_at": 0.18,
      "sound_onset": 0.062,
      "width": 240,
      "opacity": 0.55,
      "_note": "click-to-enter easter egg (fires with probability `chance`). anchor=screen-right: inside the boot laptop's terminal screen, inset px from its right edge, anchor_y = vertical position as a fraction of the screen height. sound_at = video time where the sound's onset lands. clip plays → vanishes instantly (vanish:cut) → after_ms → desktop loads.",
      "after_ms": 600,
      "anchor": "screen-right",
      "inset": 140,
      "anchor_y": 0.7,
      "vanish": "cut",
      "chance": 0.3
    },
    "boot": {
      "sound": "assets/fx/open.ogg",
      "_note": "plays when the boot screen appears IF the browser allows sound without a gesture (returning visitors / engaged origins); otherwise it plays on the boot click instead"
    }
  }
}